# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes, and the figure/dependency directories a local knit
# leaves beside the .Rmd (vignettes/demo_files/, vignettes/articles/*_files/)
vignettes/*.html
vignettes/*.pdf
vignettes/**/*_files/

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Local data, generated output, and private references
data/*
!data/.gitkeep
output/*
!output/.gitkeep
references/private/

# Local credentials and editor files
.env
.DS_Store
*.swp
*~
/doc/
/Meta/

# Private company-data work. Real modeling datasets and any source-derived
# output must never be committed. Ignore everything under scripts_private/ EXCEPT
# the template code and docs and possible example scripts.
# A parent-directory ignore would hide the whole
# tree from git and defeat the re-includes below, so ignore by content instead.
/scripts_private/**
!/scripts_private/
!/scripts_private/.gitignore
!/scripts_private/README.md
!/scripts_private/try_dp_calibrated.R

!/scripts_private/INTERNAL_STUDY.qmd
!/scripts_private/INTERNAL_STUDY.qmd
!/scripts_private/INTERNAL_STUDY.qmd
!/scripts_private/INTERNAL_STUDY.qmd
# Landing page and the publish loop over the templates above. The rendered
# pages and the published_urls.csv the loop writes are source-derived or
# environment state and stay ignored by the rule at the top of this block.
!/scripts_private/index.qmd
!/scripts_private/publish_all.R

# The study templates write their synthetic CSV to a relative `OUT_DIR`, which
# lands beside the .qmd when Quarto renders it (already covered above) but at
# the REPOSITORY ROOT when the chunks are run interactively with the project as
# the working directory -- the normal way these are used. That output is derived
# from real patients, so it must not be one `git add -A` away from a commit.
/output_*/

# Local Claude Code settings
.claude/

/.quarto/
**/*.quarto_ipynb
